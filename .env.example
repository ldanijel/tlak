# Kopirajte u .env (ili postavite kao varijable okoline poslužitelja)
PORT=3000
HOST=0.0.0.0
DB_PATH=./data/tlak.db
# Nakon što stvorite svoje račune: false (zatvara registraciju novih korisnika)
ALLOW_REGISTRATION=true
# Pozivni kod za registraciju (prazno = bez koda). Dajte ga samo ukućanima.
INVITE_CODE=
# Iza reverse proxyja (TLS): 1 (ili broj proxy skokova) da rate-limit koristi stvarni IP
TRUST_PROXY=
