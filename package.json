{
  "name": "tlak",
  "version": "1.0.0",
  "private": true,
  "description": "Web-aplikacija za osobno praćenje krvnog tlaka (PWA + online sinkronizacija)",
  "workspaces": ["server", "client"],
  "engines": { "node": ">=22.13" },
  "scripts": {
    "dev": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspace=client",
    "start": "npm run start --workspace=server",
    "test": "npm test --workspace=client && npm test --workspace=server",
    "typecheck": "npm run typecheck --workspace=client"
  }
}
